{% block sw_extension_card_base_activation_switch %}
<div class="sw-extension-card-base__info">
    <section>
        <span class="sw-extension-card-base__info-name">
            {{ extension.label }}
        </span>

        <span v-if="extension.inAppPurchasesAvailable" class="sw-extension-card-base__in-app-purchase__badge">
            {{ $tc('sw-extension.in-app-purchase.badge-label') }}
        </span>
    </section>
</div>
{% endblock %}

{% block sw_extension_card_base_context_menu_actions_additional %}
    {% parent %}

    <sw-context-menu-item v-if="extension.inAppPurchasesActive" @click="openAccountPage">
        <span class="sw-extension-card-base__context-menu-in-app-purchases-account-link">
            {{ $tc('sw-extension.in-app-purchase.context-menu.account-link-label') }}
            <sw-icon name="regular-external-link-s" size="10px" />
        </span>
    </sw-context-menu-item>
{% endblock %}
