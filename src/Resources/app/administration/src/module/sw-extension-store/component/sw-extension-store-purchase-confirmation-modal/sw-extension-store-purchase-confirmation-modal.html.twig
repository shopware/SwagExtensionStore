{% block sw_extension_store_purchase_confirmation_modal %}
<mt-modal-root
    :is-open="isOpen"
    @change="onModalChange"
>
    <mt-modal
        :ref="(el) => el?.$el.classList?.add('sw-extension-store-purchase-confirmation-modal')"
        :inset="true"
        :title="$t('sw-extension-store.purchase-confirmation.modalTitle')"
    >
        {% block sw_extension_store_purchase_confirmation_modal_content %}
        <div class="sw-extension-store-purchase-confirmation-modal__content">
            <sw-extension-store-purchase-confirmation-checkout
                v-show="view === 'checkout'"
                :cart="cart"
                :payment-means="paymentMeans"
                @modal-change-view="view = $event"
            />
            <sw-extension-store-purchase-confirmation-permissions
                v-show="view === 'permissions'"
                :cart="cart"
                @modal-change-view="view = $event"
            />
        </div>
        {% endblock %}
    </mt-modal>
</mt-modal-root>
{% endblock %}
